{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "revive-contact-email",
  "account_id": "f64f0d6c66ae5bd8797a4d4f04b68cff",
  "main": "./contact-email.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "CONTACT_EMAIL_ENABLED": "true" },
  // Add a domain-scoped, sending-only RESEND_API_KEY as an encrypted Worker secret.
  // Never put the key in this file.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "CONTACT_SITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}

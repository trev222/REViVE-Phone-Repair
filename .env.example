# Public canonical origin. Do not include a trailing path.
SITE_URL=https://revivephonerepair.com

# These settings are for local development or the Node.js SMTP fallback.
# Production uses the private Gmail Worker: add only SMTP_PASSWORD as its
# encrypted Cloudflare secret, then follow the README activation checklist.
# Credentials remain on the server; never prefix them with NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=REViVE Phone Repair <webmaster@revivephonerepair.com>
CONTACT_TO=ReviveCovington@gmail.com

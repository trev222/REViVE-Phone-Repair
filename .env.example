# Public canonical origin. Do not include a trailing path.
SITE_URL=https://revivephonerepair.com

# Set these as Cloudflare Pages runtime variables/secrets (or on a Node.js host)
# to enable contact-form delivery.
# Credentials remain on the server; never prefix them with NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=REViVE Phone Repair <webmaster@revivephonerepair.com>
CONTACT_TO=ReviveCovington@gmail.com

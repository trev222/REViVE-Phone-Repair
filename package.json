{
  "name": "revive-phone-repair",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "wrangler pages dev out",
    "deploy:pages": "npm run build:pages && wrangler pages deploy out --project-name revive-phone-repair --branch main",
    "test:pages": "npm run build:pages && TEST_TARGET=pages node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/questrial": "5.3.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  }
}
